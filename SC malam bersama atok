local function isKeyName(l)
    if has(l, "keyboard") or has(l, "monkey") or has(l, "hotkey") then return false end
    return has(l, "key") or has(l, "kunci")
end

local function keyInfo(inst)
    local l = inst.Name:lower()
    for _, k in ipairs(KEYCOLORS) do
        for _, w in ipairs(k[1]) do
            if has(l, w) then return k[2], k[3] end
        end
    end
    local p = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)
    return (p and p.Color or Color3.new(1, 1, 1)), "Kunci"
end

local function match(l, inst)
    for _, r in ipairs(RULES) do
        if r.kind == "key" then
            if isKeyName(l) then
                local c, n = keyInfo(inst)
                return "key", n, c
            end
        else
            if not (r.bad and nameHit(l, r.bad)) and nameHit(l, r.words) then
                return r.kind, r.label, r.color
            end
        end
    end
end

-- ===== ESP =====
local function adorneePart(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart")
            or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    if inst:IsA("Tool") then
        return inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true)
    end
end

local function add(inst, kind, name, color)
    if tracked[inst] then return end
    local part = adorneePart(inst)
    if not part then return end
    local hl = Instance.new("Highlight")
    hl.Adornee = inst
    hl.FillColor, hl.OutlineColor = color, color
    hl.FillTransparency = 0.6
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = false
    hl.Parent = ROOT
    local bb = Instance.new("BillboardGui")
    bb.Adornee = part
    bb.AlwaysOnTop = true
    bb.Size = UDim2.fromOffset(150, 30)
    bb.StudsOffset = Vector3.new(0, OFFS[kind] or 3, 0)
    bb.MaxDistance = math.huge
    bb.Enabled = false
    bb.Parent = ROOT
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.fromScale(1, 1)
    tl.BackgroundTransparency = 1
    tl.TextColor3 = color
    tl.TextStrokeTransparency = 0
    tl.Font = Enum.Font.GothamBold
    tl.TextSize = 12
    tl.Text = name
    tl.Parent = bb
    tracked[inst] = {kind = kind, name = name, hl = hl, bb = bb, tl = tl, part = part}
end

local function inChar(inst)
    for _, p in ipairs(Players:GetPlayers()) do
        local c = p.Character
        if c and (inst == c or inst:IsDescendantOf(c)) then return true end
    end
    return false
end

local function ancestorTracked(inst, onlyKind)
    local p = inst.Parent
    while p and p ~= workspace do
        local e = tracked[p]
        if e and (not onlyKind or e.kind == onlyKind) then return true end
        p = p.Parent
    end
    return false
end

-- ===== PROMPT (instan + jarak) =====
local promptOrig = setmetatable({}, {__mode = "k"})
local function tune(p)
    if not promptOrig[p] then
        promptOrig[p] = {p.HoldDuration, p.MaxActivationDistance, p.RequiresLineOfSight}
    end
    local o = promptOrig[p]
    p.HoldDuration = instantOn and 0 or o[1]
    p.MaxActivationDistance = rangeOn and 30 or o[2]
    p.RequiresLineOfSight = (not rangeOn) and o[3] or false
end
local function refreshPrompts()
    local n = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then pcall(tune, d) end
        n = n + 1
        if n % 600 == 0 then task.wait() end
    end
end
local function restorePrompts()
    for p, o in pairs(promptOrig) do
        pcall(function()
            p.HoldDuration, p.MaxActivationDistance, p.RequiresLineOfSight = o[1], o[2], o[3]
        end)
    end
end

-- ===== ANTI LAG =====
local lagOn = false
local lagSaved = setmetatable({}, {__mode = "k"})
local lagQuality, lagShadows

local function lagApplyInst(d)
    if lagSaved[d] then return end
    if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke")
        or d:IsA("Fire") or d:IsA("Sparkles") then
        lagSaved[d] = {Enabled = d.Enabled}
        d.Enabled = false
    elseif d:IsA("BasePart") then
        if d.CastShadow then
            lagSaved[d] = {CastShadow = true}
            d.CastShadow = false
        end
    end
end

local function lagApplyAll()
    pcall(function()
        local s = settings().Rendering
        if lagQuality == nil then lagQuality = s.QualityLevel end
        s.QualityLevel = Enum.QualityLevel.Level01
    end)
    pcall(function()
        if lagShadows == nil then lagShadows = Lighting.GlobalShadows end
        Lighting.GlobalShadows = false
    end)
    for _, e in ipairs(Lighting:GetChildren()) do
        if e:IsA("PostEffect") and not lagSaved[e] then
            lagSaved[e] = {Enabled = e.Enabled}
            e.Enabled = false
        end
    end
    local n = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if not lagOn then return end
        pcall(lagApplyInst, d)
        n = n + 1
        if n % 400 == 0 then task.wait() end
    end
end

local function lagRestore()
    for d, o in pairs(lagSaved) do
        pcall(function() for k, v in pairs(o) do d[k] = v end end)
        lagSaved[d] = nil
    end
    pcall(function()
        if lagQuality ~= nil then
            settings().Rendering.QualityLevel = lagQuality
            lagQuality = nil
        end
    end)
    pcall(function()
        if lagShadows ~= nil then
            Lighting.GlobalShadows = lagShadows
            lagShadows = nil
        end
    end)
end

-- ===== KLASIFIKASI =====
local function classify(inst)
    if inst:IsDescendantOf(ROOT) or tracked[inst] then return end

    if inst:IsA("ProximityPrompt") then
        tune(inst)
        local t = inst.Parent
        if t and t:IsA("Attachment") then t = t.Parent end
        if not t or tracked[t] or inChar(t) or ancestorTracked(t) then return end
        local tl = t.Name:lower()
        if isAtokHouse(tl) or nameHit(tl, SPIDER_WORDS) then return end
        local txt = ((inst.ActionText or "") .. " " .. (inst.ObjectText or "") .. " " .. t.Name):lower()
        local kind, label, color = match(txt, t)
        if not kind then return end -- barang umum (lemari kayu dll) nggak ditandai
        add(t, kind, label, color)
        return
    end

    if not (inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Tool")) then return end
    local l = inst.Name:lower()

    local kind, label, color
    if nameHit(l, SPIDER_WORDS) then
        kind, label, color = "spider", "Laba-laba", Color3.fromRGB(190, 120, 255)
    elseif isAtok(inst, l) then
        kind, label, color = "atok", "ATOK", Color3.fromRGB(255, 40, 40)
    else
        if isAtokHouse(l) then return end
        kind, label, color = match(l, inst)
    end
    if not kind then
        if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid")
            and not Players:GetPlayerFromCharacter(inst) then
            kind, label, color = "npc", inst.Name, Color3.fromRGB(255, 140, 0)
        else
            return
        end
    end
    if inChar(inst) then return end
    if kind == "atok" then
        if ancestorTracked(inst, "atok") then return end
    else
        if ancestorTracked(inst) then return end
    end
    add(inst, kind, label, color)
end

local function scan()
    local n = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        pcall(classify, d)
        n = n + 1
        if n % 400 == 0 then task.wait() end
    end
end

local function hookPlayer(p)
