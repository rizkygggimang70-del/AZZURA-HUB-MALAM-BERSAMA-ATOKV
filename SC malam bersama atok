local function has(s, w) return s:find(w, 1, true) ~= nil end
local function nameHit(l, list)
    for _, w in ipairs(list) do if has(l, w) then return true end end
    return false
end

-- ===== ATOK =====
local ATOK_WORDS = {"atok", "opah", "kakek"}
local ATOK_ALT = {"monster", "hantu", "ghost", "killer", "enemy", "musuh", "chaser"}
local SPIDER_WORDS = {"laba", "spider", "tarantula"}
local HOUSE_BAD = {"rumah","house","home","pintu","door","wall","dinding","room","bilik",
    "building","gedung","map","lantai","floor","atap","roof","jendela","window","spawn",
    "bengkel","workshop","garasi","garage","gudang","kamar","dapur","ruang","lorong",
    "area","zone","basement","loteng","attic","teras","halaman","kebun","gubuk","pondok",
    "shed","cabin","hut","folder","tempat","lokasi"}

local function isAtokHouse(l)
    return nameHit(l, ATOK_WORDS) and nameHit(l, HOUSE_BAD)
end

local function isAtok(inst, l)
    if not inst:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(inst) then return false end
    if inst:FindFirstChildOfClass("Humanoid") then
        return nameHit(l, ATOK_WORDS) or nameHit(l, ATOK_ALT)
    end
    if not nameHit(l, ATOK_WORDS) then return false end
    if nameHit(l, HOUSE_BAD) then return false end
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("Humanoid") then return false end
    end
    local ok, size = pcall(function() return inst:GetExtentsSize() end)
    return ok and size.Magnitude > 0.5 and size.Magnitude < 18
end

