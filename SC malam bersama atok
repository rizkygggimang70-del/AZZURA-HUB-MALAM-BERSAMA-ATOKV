-- Antrian objek baru: diproses bertahap (maks 150 tiap 0.2 detik) supaya nggak lag
local pending, pHead = {}, 1
table.insert(conns, workspace.DescendantAdded:Connect(function(d)
    pending[#pending + 1] = {d, os.clock()}
end))

local function drainPending()
    local n = 0
    while pHead <= #pending and n < 150 do
        local e = pending[pHead]
        if os.clock() - e[2] < 0.4 then break end
        pending[pHead] = false
        pHead = pHead + 1
        n = n + 1
        local d = e[1]
        if d.Parent then
            pcall(classify, d)
            if lagOn then pcall(lagApplyInst, d) end
        end
    end
    if pHead > #pending then pending, pHead = {}, 1 end
end

