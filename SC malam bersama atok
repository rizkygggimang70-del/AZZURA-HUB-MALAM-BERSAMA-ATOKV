            c:WaitForChild("HumanoidRootPart", 10)
            pcall(add, c, "player", p.DisplayName, Color3.fromRGB(0, 190, 255))
        end)
    end
    if p.Character then onChar(p.Character) end
    table.insert(conns, p.CharacterAdded:Connect(onChar))
end

