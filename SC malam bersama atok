-- ===== LOOP UTAMA =====
local acc = 0
table.insert(conns, RS.Heartbeat:Connect(function(dt)
    if speedOn then
        local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if h and h.WalkSpeed ~= speedVal then h.WalkSpeed = speedVal end
    end
    if lightOn and Lighting.Brightness ~= 2 then
        Lighting.Brightness = 2
        Lighting.Ambient = Color3.fromRGB(140, 140, 140)
        Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 140)
        Lighting.FogEnd = 1e6
        Lighting.GlobalShadows = false
    end
    acc = acc + dt
    if acc < 0.2 then return end
    acc = 0

    drainPending()

    local c = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    local nearAtok
    for inst, e in pairs(tracked) do
        if not inst.Parent or not e.part.Parent then
            e.hl:Destroy(); e.bb:Destroy(); tracked[inst] = nil
        else
            local on = ON[e.kind]
            local d = root and (e.part.Position - root.Position).Magnitude
            if d and MAXD[e.kind] and d > MAXD[e.kind] then on = false end
            e.hl.Enabled, e.bb.Enabled = on, on
            if on and d then e.tl.Text = e.name .. " [" .. math.floor(d) .. "m]" end
            if e.kind == "atok" and d and (not nearAtok or d < nearAtok) then nearAtok = d end
        end
    end
    if alarmLbl then
        if alarmOn and nearAtok and nearAtok < 70 then
            alarmLbl.Text = "AWAS! ATOK DEKAT [" .. math.floor(nearAtok) .. "m]"
            alarmLbl.Visible = true
        else
            alarmLbl.Visible = false
        end
    end
end))

-- ===== STOP =====
local function stop()
    noclipOn = false; lightOn = false; instantOn = false; rangeOn = false
    DC.on = false
    lagOn = false
    pcall(lagRestore)
    setLight(false)
    restorePrompts()
    local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if speedOn and h then h.WalkSpeed = origSpeed end
    speedOn = false
    for _, cn in ipairs(conns) do pcall(function() cn:Disconnect() end) end
    pcall(function() ROOT:Destroy() end)
    pcall(function() if sg then sg:Destroy() end end)
end
if getgenv then getgenv().AZ_ATOK_STOP = stop end

